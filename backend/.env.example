APP_ENV=development
APP_NAME=Tiquetera Nube
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173

# mock | ldap   (mock solo se acepta con APP_ENV=development)
AUTH_PROVIDER=mock
MOCK_USERS_FILE=./mock_users.json

JWT_SECRET=reemplazar-por-64-caracteres-aleatorios
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
COOKIE_NAME=tq_sesion
COOKIE_SECURE=false

LDAP_URI=ldaps://20.226.44.141:636
LDAP_CA_CERT_PATH=./certs/ad-ca.pem
LDAP_TLS_NOMBRE=srv-ad.tpsnube.local
LDAP_TIMEOUT_SECONDS=5
LDAP_BASE_DN=DC=tpsnube,DC=local
LDAP_USER_SEARCH_BASE=OU=Usuarios,OU=Tiquetera,DC=tpsnube,DC=local
LDAP_BIND_DN=CN=svc-tiquetera,OU=Servicios,OU=Tiquetera,DC=tpsnube,DC=local
LDAP_BIND_PASSWORD=

LDAP_GROUP_ADMIN=CN=GG-TQ-Admin,OU=Grupos,OU=Tiquetera,DC=tpsnube,DC=local
LDAP_GROUP_OPERADOR=CN=GG-TQ-Operador,OU=Grupos,OU=Tiquetera,DC=tpsnube,DC=local
LDAP_GROUP_USUARIO=CN=GG-TQ-Usuario,OU=Grupos,OU=Tiquetera,DC=tpsnube,DC=local
LDAP_GROUP_CONSULTA=CN=GG-TQ-Consulta,OU=Grupos,OU=Tiquetera,DC=tpsnube,DC=local

ACCESS_TIMEZONE=America/Argentina/Buenos_Aires
ACCESS_WINDOW_START=08:00
ACCESS_WINDOW_END=18:00
# dias ISO: 1=lunes ... 7=domingo
ACCESS_DAYS=1,2,3,4,5
# solo development, para capturar evidencias: 2026-11-05T19:30:00
CLOCK_OVERRIDE=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

DATA_DIR=./data
TICKETS_FILE=tickets.json

CSV_DELIMITER=;
